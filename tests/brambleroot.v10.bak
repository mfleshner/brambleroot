function drawWell(g, season) {
  const b = BUILD.well, cx = ox + (b.c + .5) * T, y = oy + b.r * T, u = T / 16;
  R(g, cx - 6 * u, y + 2 * u, u * 1.5, 9 * u, '#5a3d26'); R(g, cx + 4.5 * u, y + 2 * u, u * 1.5, 9 * u, '#5a3d26');
  g.fillStyle = season === 3 ? '#f4f8fb' : '#5a3a6c'; g.beginPath(); g.moveTo(cx - 8 * u, y + 3 * u); g.lineTo(cx, y - 1 * u); g.lineTo(cx + 8 * u, y + 3 * u); g.closePath(); g.fill();
  R(g, cx - 6.5 * u, y + 9 * u, 13 * u, 6 * u, '#8b8273');
