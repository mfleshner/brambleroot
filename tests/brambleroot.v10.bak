<title>Brambleroot</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IM+Fell+English+SC&family=Atkinson+Hyperlegible:wght@400;700&display=swap">
<style>
/* Layout: one-screen portrait garden on canvas; HUD strip on top, thumb tray at bottom, bottom sheets for menus. Single committed dusk look. */
:root{
  color-scheme: dark;
  --ink:#1c1324;
  --ink2:#2a1d36;
  --line:#4a3858;
  --text:#f2e8dc;
  --muted:#b9a8c2;
  --gold:#f2b84b;
  --moss:#8fcf6a;
  --water:#6cc3ef;
  --rose:#ef7a8c;
  --display:'IM Fell English SC', 'Palatino Linotype', Georgia, serif;
  --body:'Atkinson Hyperlegible', system-ui, -apple-system, 'Segoe UI', sans-serif;
}
html,body{height:100%}
body{background:#1a2a1c;color:var(--text);font-family:var(--body);font-size:15px;overflow:hidden;touch-action:none;-webkit-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent}
#c{position:fixed;inset:0;width:100%;height:100%;display:block}
button{font-family:var(--body);color:inherit;cursor:pointer}
button:focus-visible{outline:2px solid var(--gold);outline-offset:2px}

#hud{position:fixed;left:0;right:0;top:0;z-index:4;display:flex;flex-direction:column;gap:6px;
  background:linear-gradient(var(--ink) 70%, rgba(28,19,36,0));
  padding-top:calc(env(safe-area-inset-top,0px) + 8px);padding-bottom:12px;
  padding-left:max(16px, env(safe-area-inset-left,0px));padding-right:max(16px, env(safe-area-inset-right,0px));pointer-events:none}
.r1,.r2{display:flex;align-items:center;gap:10px}
.when{display:flex;align-items:baseline;gap:6px;white-space:nowrap}
.dayn{font-family:var(--display);font-size:22px;line-height:1;color:var(--text)}
.of{font-size:12px;color:var(--muted)}
.clock{font-size:14px;color:var(--muted);font-variant-numeric:tabular-nums;white-space:nowrap}
.wx{font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--water);border:1px solid rgba(108,195,239,.45);border-radius:999px;padding:2px 7px;white-space:nowrap}
.coins{margin-left:auto;display:flex;align-items:center;gap:6px;font-weight:700;font-size:18px;color:var(--gold);font-variant-numeric:tabular-nums}
.coin{width:14px;height:14px;border-radius:50%;background:radial-gradient(circle at 35% 35%,#ffe39a,#d9952a 70%);box-shadow:0 0 0 1px #7a4d12}
.meter{display:flex;align-items:center;gap:6px;flex:1;min-width:0}
.ml{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);white-space:nowrap}
.bar{flex:1;height:8px;border-radius:4px;background:#3a2b46;overflow:hidden;min-width:28px}
.bar i{display:block;height:100%;width:100%;background:var(--moss);transition:width .2s}
.bar.water i{background:var(--water)}
.goal{font-size:12px;color:var(--muted);white-space:nowrap;font-variant-numeric:tabular-nums}
.goal b{color:var(--text);font-weight:700}

#tray{position:fixed;left:0;right:0;bottom:0;z-index:4;display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:5px;background:var(--ink);border-top:1px solid var(--line);
  padding-top:8px;padding-bottom:calc(env(safe-area-inset-bottom,0px) + 8px);
  padding-left:max(8px, env(safe-area-inset-left,0px));padding-right:max(8px, env(safe-area-inset-right,0px))}
.tb{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;min-height:56px;background:var(--ink2);border:1px solid var(--line);border-radius:10px;font-size:11px;color:var(--text);padding:6px 2px;min-width:0}
.tb:active{transform:translateY(1px);background:#35263f}
.tb svg{width:22px;height:22px}
.tb .sw{width:18px;height:18px;border-radius:50%;border:2px solid rgba(0,0,0,.35)}
.tb .lbl{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}
.badge{position:absolute;top:3px;right:4px;min-width:17px;height:17px;border-radius:9px;background:var(--rose);color:#2a0d14;font-size:10.5px;font-weight:700;display:grid;place-items:center;padding:0 4px}

#toast{position:fixed;left:50%;transform:translateX(-50%);z-index:5;max-width:min(88vw,440px);background:rgba(28,19,36,.94);border:1px solid var(--line);border-radius:10px;padding:10px 14px;font-size:14px;line-height:1.35;text-align:center;pointer-events:none;box-shadow:0 8px 24px rgba(0,0,0,.4)}

#scrim{position:fixed;inset:0;z-index:8;background:rgba(10,6,14,.45)}
#sheet{position:fixed;left:0;right:0;bottom:0;z-index:9;display:flex;justify-content:center}
.sheet{width:100%;max-width:560px;max-height:min(80vh, 700px);display:flex;flex-direction:column;background:var(--ink);border:1px solid var(--line);border-bottom:0;border-radius:16px 16px 0 0;box-shadow:0 -10px 40px rgba(0,0,0,.45)}
.sh-head{display:flex;align-items:center;gap:12px;padding:16px 16px 10px}
.sh-head h3{margin:0;font-family:var(--display);font-weight:400;font-size:26px;line-height:1.05;text-wrap:balance;flex:1}
.x{background:var(--ink2);border:1px solid var(--line);border-radius:8px;padding:8px 12px;font-size:13px;white-space:nowrap}
.sh-body{overflow-y:auto;padding:0 16px calc(env(safe-area-inset-bottom,0px) + 18px);display:flex;flex-direction:column;gap:10px;-webkit-overflow-scrolling:touch;touch-action:pan-y}
.sub{margin:0;color:var(--muted);font-size:14px;line-height:1.45}
.tabs{display:flex;gap:6px}
.tab{flex:1;background:var(--ink2);border:1px solid var(--line);border-radius:8px;padding:9px 6px;font-size:13px;color:var(--muted)}
.tab[aria-selected="true"]{background:var(--gold);border-color:var(--gold);color:#2a1a05;font-weight:700}
.row{display:flex;align-items:center;gap:12px;padding:10px 12px;background:var(--ink2);border:1px solid var(--line);border-radius:10px}
.row .dot{flex:none;width:26px;height:26px;border-radius:50%;border:2px solid rgba(0,0,0,.4)}
.row .info{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}
.row .name{font-weight:700;font-size:15px}
.row .meta{font-size:12.5px;color:var(--muted);line-height:1.35}
.row .acts{display:flex;gap:6px;flex:none}
.row.sel{border-color:var(--gold)}
.row.dim{opacity:.55}
.btn{background:var(--gold);color:#2a1a05;border:0;border-radius:8px;padding:9px 12px;font-weight:700;font-size:13px;white-space:nowrap}
.btn.alt{background:#3a2b46;color:var(--text);border:1px solid var(--line)}
.btn:disabled{background:#3a2b46;color:#7d6d88;cursor:default}
.card{display:flex;flex-direction:column;gap:8px;padding:12px;background:var(--ink2);border:1px solid var(--line);border-radius:12px}
.card.done{border-color:rgba(143,207,106,.6)}
.card h4{margin:0;font-family:var(--display);font-weight:400;font-size:20px;line-height:1.1}
.who{display:flex;align-items:center;gap:10px}
.pf{width:34px;height:34px;flex:none;border-radius:50%;display:grid;place-items:center;font-family:var(--display);font-size:18px;color:#1c1324}
.nm{font-weight:700}
.role{font-size:12px;color:var(--muted)}
.card q{font-style:italic;color:#e3d6e8;line-height:1.45;quotes:"\201C" "\201D"}
.foot{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.need{font-size:13.5px}
.due{font-size:12px;color:var(--muted)}
.due.hot{color:var(--rose)}
.rw{margin-left:auto;font-size:13px;color:var(--gold);font-weight:700;white-space:nowrap}
.hearts{display:flex;gap:3px}
.hearts i{width:9px;height:9px;border-radius:2px;background:#3a2b46;transform:rotate(45deg)}
.hearts i.on{background:var(--rose)}
.prog{display:flex;flex-direction:column;gap:6px}
.pl{display:flex;align-items:center;gap:8px;font-size:13.5px}
.pl .bar{height:6px}
.pl span:first-child{flex:none;width:44%;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pl .n{flex:none;font-variant-numeric:tabular-nums;color:var(--muted);font-size:12.5px}
.lines{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:6px}
.lines li{padding:9px 12px;background:var(--ink2);border-radius:8px;border-left:3px solid var(--moss);font-size:14px;line-height:1.4}
.lines li.bad{border-left-color:var(--rose)}
.lines li.gold{border-left-color:var(--gold)}
.lines li.gift{border-left-color:#c9b6ff}
.lines li.withpor{display:flex;align-items:center;gap:10px}
.por{display:block;flex:none;border-radius:50%;box-shadow:0 0 0 2px rgba(0,0,0,.35)}
.por.q{width:52px;height:52px;display:grid;place-items:center;background:#3a2b46;font-family:var(--display);font-size:24px;color:var(--muted)}
.vrow{display:flex;align-items:center;gap:12px;width:100%;text-align:left;padding:10px 12px;background:var(--ink2);border:1px solid var(--line);border-radius:12px}
.vrow.dim{opacity:.55}
.vrow .info{flex:1;min-width:0;display:flex;flex-direction:column;gap:4px}
.vrow .name{font-weight:700;font-size:15px}
.vrow .meta{font-size:12.5px;color:var(--muted)}
.chev{font-size:26px;color:var(--muted);line-height:1}
.vhead{display:flex;align-items:center;gap:16px}
.vhead .info{display:flex;flex-direction:column;gap:6px;min-width:0}
.vhead .meta{font-size:13px;color:var(--muted)}
.bubble{position:relative;margin-top:4px;background:#f4ead9;color:#2a1d36;border-radius:14px;padding:12px 14px;font-size:15.5px;line-height:1.45}
.bubble::before{content:"";position:absolute;left:34px;top:-9px;border:9px solid transparent;border-top:0;border-bottom-color:#f4ead9}
.scene{margin:0;font-size:16.5px;line-height:1.6;color:#efe4f2;max-width:52ch}
.big{font-family:var(--display);font-size:46px;line-height:1;color:var(--gold)}
.cta-row{display:flex;gap:8px;flex-wrap:wrap}
.cta-row .btn{flex:1;padding:13px 14px;font-size:15px}
.cal{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.cal div{background:var(--ink2);border:1px solid var(--line);border-radius:10px;padding:10px;font-size:13px;line-height:1.5;color:var(--muted)}
.cal div b{display:block;color:var(--text);font-family:var(--display);font-weight:400;font-size:17px}
.cal div.now{border-color:var(--gold)}

/* fishing */
.pond{position:relative;height:46px;border-radius:10px;background:linear-gradient(#2f6f8c,#24546b);overflow:hidden;border:1px solid var(--line)}
.pond .zone{position:absolute;top:0;bottom:0;background:rgba(143,207,106,.45);border-left:2px solid var(--moss);border-right:2px solid var(--moss)}
.pond .mark{position:absolute;top:4px;bottom:4px;width:6px;margin-left:-3px;border-radius:3px;background:var(--gold);box-shadow:0 0 10px rgba(242,184,75,.8)}
.reel{width:100%;padding:18px;font-size:18px}

#title{position:fixed;inset:0;z-index:10;display:flex;flex-direction:column;justify-content:flex-end;
  background:linear-gradient(to top, rgba(20,12,28,.96) 38%, rgba(20,12,28,.55) 70%, rgba(20,12,28,.15));
  padding-top:calc(env(safe-area-inset-top,0px) + 24px);padding-bottom:calc(env(safe-area-inset-bottom,0px) + 28px);
  padding-left:max(20px, env(safe-area-inset-left,0px));padding-right:max(20px, env(safe-area-inset-right,0px))}
.tw{max-width:520px;width:100%;margin:0 auto;display:flex;flex-direction:column;gap:14px}
.kicker{margin:0;font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--moss)}
#title h1{margin:0;font-family:var(--display);font-weight:400;font-size:clamp(52px,15vw,84px);line-height:.9;color:var(--text);text-shadow:0 2px 0 #3a2148, 0 0 30px rgba(242,184,75,.25)}
.story{margin:0;font-size:16px;line-height:1.5;color:#e6dbe9;max-width:42ch}
.story b{color:var(--gold)}
.how{margin:0;padding:0;list-style:none;display:grid;grid-template-columns:auto 1fr;gap:6px 10px;font-size:14px;color:var(--muted)}
.how li{display:contents}
.how span:first-child{color:var(--text);font-weight:700}
@media (prefers-reduced-motion: reduce){.bar i{transition:none}}
</style>

<canvas id="c" aria-label="Your garden"></canvas>

<header id="hud">
  <div class="r1">
    <div class="when"><span class="dayn" id="dayLbl">Spring 1</span><span class="of" id="ofLbl">of 14</span></div>
    <span class="clock" id="clock">6:00 am</span>
    <span class="wx" id="wx" hidden>Rain</span>
    <div class="coins"><i class="coin"></i><span id="coins">150</span></div>
  </div>
  <div class="r2">
    <div class="meter"><span class="ml">Energy</span><span class="bar"><i id="enBar"></i></span></div>
    <div class="meter"><span class="ml">Can</span><span class="bar water"><i id="canBar"></i></span></div>
    <div class="goal" id="goalTxt"></div>
  </div>
</header>

<nav id="tray">
  <button class="tb" id="bSeeds" type="button"><span class="sw" id="seedSw"></span><span class="lbl" id="seedLbl">Mint ×6</span></button>
  <button class="tb" id="bMarket" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="#f2b84b" stroke-width="1.8" stroke-linejoin="round"><path d="M5 9h14l-1.2 11H6.2z"/><path d="M9 9V7a3 3 0 0 1 6 0v2"/></svg><span class="lbl">Market</span></button>
  <button class="tb" id="bBoard" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="#f2e8dc" stroke-width="1.8" stroke-linejoin="round"><rect x="4" y="4" width="16" height="13" rx="1.5"/><path d="M8 17v4M16 17v4M8 9h8M8 12.5h5"/></svg><span class="lbl">Requests</span><span class="badge" id="reqBadge" hidden>0</span></button>
  <button class="tb" id="bPot" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="#8fcf6a" stroke-width="1.8" stroke-linejoin="round"><path d="M4 10h16c0 6-3.5 9-8 9s-8-3-8-9z"/><path d="M3 10h18M7 19l-1 2M17 19l1 2"/><circle cx="10" cy="6" r="1.2"/><circle cx="14" cy="4.5" r="1"/></svg><span class="lbl">Cauldron</span><span class="badge" id="potBadge" hidden>0</span></button>
  <button class="tb" id="bJournal" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="#ef7a8c" stroke-width="1.8" stroke-linejoin="round"><path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3z"/><path d="M5 17a3 3 0 0 1 3-3h11"/><path d="M10 7.5l1.5 1.5 3-3"/></svg><span class="lbl">Journal</span></button>
  <button class="tb" id="bSleep" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="#c9b6ff" stroke-width="1.8" stroke-linejoin="round"><path d="M19 14.5A7.5 7.5 0 0 1 9.5 5a7.5 7.5 0 1 0 9.5 9.5z"/></svg><span class="lbl">Sleep</span></button>
</nav>

<div id="toast" hidden></div>
<div id="scrim" hidden></div>
<div id="sheet" hidden><div class="sheet" role="dialog" aria-modal="true" aria-labelledby="shTitle"><div class="sh-head"><h3 id="shTitle"></h3><button class="x" id="shClose" type="button">Close</button></div><div class="sh-body" id="shBody"></div></div></div>

<section id="title">
  <div class="tw">
    <p class="kicker">A witch's year, fourteen days a season</p>
    <h1>Brambleroot</h1>
    <p class="story">Aunt Bramble left you her cottage, her cat, and a debt of <b>2,000 coins</b> to the Witches' Guild, due when spring ends. Grow herbs through four seasons, brew potions, befriend the village, and make the place your own.</p>
    <ul class="how">
      <li><span>Tap</span><span>a garden tile to till, plant, water or harvest it.</span></li>
      <li><span>Drag</span><span>across rows to queue up a whole line of work.</span></li>
      <li><span>Brew</span><span>potions overnight. They sell for far more than raw herbs.</span></li>
    </ul>
    <div class="cta-row" id="titleBtns"></div>
  </div>
</section>

<script>
(() => {
'use strict';
const C = document.getElementById('c'), ctx = C.getContext('2d');
const $ = id => document.getElementById(id);
const reduceMotion = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;

/* ================= data ================= */
const DAYS = 14, SAVE_KEY = 'brambleroot-save-v1';
const SEASONS = ['Spring', 'Summer', 'Autumn', 'Winter'];
const RAIN = [.22, .12, .25, 0];
const CROPS = {
  mint:   { name:'Calm-mint',   seed:10, sell:20,  grow:3, seasons:[0,1], unlock:1, col:'#7fd39a' },
  ember:  { name:'Emberroot',   seed:20, sell:46,  grow:4, seasons:[0,2], unlock:1, col:'#ff8a4a' },
  moon:   { name:'Moonpetal',   seed:25, sell:55,  grow:4, seasons:[0],   unlock:3, col:'#cdbbff' },
  thorn:  { name:'Thornberry',  seed:40, sell:18,  grow:5, seasons:[0,1], unlock:3, col:'#c23a78', regrow:2, yield:2 },
  glow:   { name:'Glowcap',     seed:45, sell:110, grow:6, seasons:[0,2], unlock:5, col:'#5ff0d8', noWater:true },
  pepper: { name:'Sunpepper',   seed:30, sell:70,  grow:4, seasons:[1],   unlock:1, col:'#ff4d3a' },
  star:   { name:'Starfruit',   seed:70, sell:55,  grow:7, seasons:[1],   unlock:3, col:'#ffd84a', regrow:3, yield:2 },
  melon:  { name:'Bellmelon',   seed:60, sell:220, grow:8, seasons:[1],   unlock:1, col:'#9fd86a' },
  gourd:  { name:'Hollowgourd', seed:50, sell:180, grow:7, seasons:[2],   unlock:1, col:'#f08c2a' },
  wolf:   { name:'Wolfsbane',   seed:35, sell:75,  grow:5, seasons:[2],   unlock:1, col:'#8f80ff' },
  frost:  { name:'Frostmoss',   seed:40, sell:90,  grow:5, seasons:[3],   unlock:1, col:'#a8e6ff', noWater:true }
};
const POTIONS = {
  calming:  { name:'Calming Draught', need:{ mint:2 },          sell:70,  col:'#7fd39a' },
  hearth:   { name:'Hearth Tonic',    need:{ ember:1, mint:1 }, sell:110, col:'#ff8a4a' },
  dream:    { name:'Dreamwater',      need:{ moon:2 },          sell:150, col:'#cdbbff' },
  jam:      { name:'Thornberry Jam',  need:{ thorn:4 },         sell:120, col:'#c23a78' },
  elixir:   { name:'Glow Elixir',     need:{ glow:1, moon:1 },  sell:260, col:'#5ff0d8' },
  salve:    { name:'Sunfire Salve',   need:{ pepper:2 },        sell:200, col:'#ff4d3a' },
  starlight:{ name:'Starlight Tonic', need:{ star:2 },          sell:210, col:'#ffd84a' },
  cordial:  { name:'Melon Cordial',   need:{ melon:1, mint:1 }, sell:330, col:'#9fd86a' },
  amber:    { name:'Amber Syrup',     need:{ gourd:1, ember:1 },sell:320, col:'#f08c2a' },
  ward:     { name:"Wolf's Ward",     need:{ wolf:2 },          sell:210, col:'#8f80ff' },
  frostel:  { name:'Frost Elixir',    need:{ frost:3 },         sell:330, col:'#a8e6ff' }
};
const FISH = {
  minnow:   { name:'Minnow',       sell:15,  seasons:[0,1,2,3], diff:0, w:5, col:'#9fb6c4' },
  trout:    { name:'Spring Trout', sell:50,  seasons:[0], diff:1, w:3, col:'#d6a3be' },
  sunfish:  { name:'Sunfish',      sell:55,  seasons:[1], diff:1, w:3, col:'#f2c04b' },
  perch:    { name:'Copper Perch', sell:45,  seasons:[2], diff:1, w:3, col:'#d0783a' },
  mudcat:   { name:'Mudcat',       sell:75,  seasons:[2,3], diff:1, w:2, col:'#9a8a6a' },
  iceperch: { name:'Ice Perch',    sell:70,  seasons:[3], diff:1, w:3, col:'#bfe6ff' },
  moonfish: { name:'Moonfish',     sell:180, seasons:[0,1,2,3], diff:2, w:.6, col:'#d8d0ff' }
};
const MISC = {
  honey:     { name:'Wildflower Honey', sell:60,  col:'#f2b84b' },
  starshard: { name:'Starshard',        sell:250, col:'#fff1a8' }
};
const ITEMS = Object.assign({}, CROPS, POTIONS, FISH, MISC);
const itemName = id => ITEMS[id] ? ITEMS[id].name : id;
const itemValue = id => ITEMS[id] ? ITEMS[id].sell : 0;
const itemCol = id => ITEMS[id] ? ITEMS[id].col : '#888';

const UPGRADES = {
  can:   { name:'Copper watering can', desc:'Holds 40 waterings.', cost:180 },
  can2:  { name:'Silver watering can', desc:'Holds 70 waterings.', cost:450, needs:'can' },
  pot2:  { name:'Second cauldron', desc:'Brew two potions each night.', cost:250 },
  pot3:  { name:'Third cauldron', desc:'Brew three potions each night.', cost:600, needs:'pot2' },
  pot4:  { name:'Fourth cauldron', desc:'Brew four potions each night.', cost:1200, needs:'pot3', season:1 },
  rod:   { name:'Fishing rod', desc:'Fish at the pond.', cost:300, once:'rod' },
  sprinkler: { name:'Brass sprinkler', desc:'Waters the four beds around it every morning. Place it from your seed pouch.', cost:150, repeat:true }
};

const PROJECTS = {
  greenhouse: { short:'Greenhouse', season:1, name:'Restore the greenhouse', desc:"Aunt Bramble's old glasshouse over the two bottom rows. Once restored, anything grows there in any season, even winter.", coins:1500, items:{ pepper:8, star:4 }, reward:'The bottom two rows of the garden grow any crop, any season.' },
