/* ================= map ================= */
const COLS = 9, ROWS = 13;
const FIELD = { c0:1, c1:7, r0:3, r1:10 };
const GH_ROW = 9;
const BUILD = {
  cottage: { c:0, r:0, w:3, h:2, stand:[1,2] },
  cauldron:{ c:4, r:1, w:1, h:1, stand:[4,2] },
  board:   { c:6, r:1, w:1, h:1, stand:[6,2] },
  well:    { c:8, r:1, w:1, h:1, stand:[8,2] },
  stall:   { c:8, r:11, w:1, h:1, stand:[7,11] },
  pond:    { c:1, r:12, w:2, h:1, stand:[1,11] }
};
const inField = (c, r) => c >= FIELD.c0 && c <= FIELD.c1 && r >= FIELD.r0 && r <= FIELD.r1;
const plotIdx = (c, r) => (c - FIELD.c0) + (r - FIELD.r0) * 7;
const plotRow = i => FIELD.r0 + Math.floor(i / 7), plotCol = i => FIELD.c0 + i % 7;
function buildingAt(c, r) {
  for (const k in BUILD) { const b = BUILD[k]; if (c >= b.c && c < b.c + b.w && r >= b.r && r < b.r + b.h) return k; }
  return null;
}
function hash(a, b, c) {
  let n = (a * 374761393 + b * 668265263 + c * 1274126177) | 0;
  n = Math.imul(n ^ (n >>> 13), 1274126177);
  return ((n ^ (n >>> 16)) >>> 0) / 4294967295;
}
function tileKind(c, r) {
  if (inField(c, r)) return 'field';
  if (r === 2 || r === 11) return 'path';
  if (c === 8 && r > 2 && r < 11) return 'path';
  if (r === 12 && (c === 1 || c === 2)) return 'pond';
  return 'grass';
}
const PAL = [
  { g:['#4d7838', '#4a7436'], bl:['#5f8d45', '#3d6530'], path:['#8f7752', '#a68c63', '#7a6444'], tree:['#1f3b24', '#2c5130', '#3b6a3a'], forest:'#1b2d1d', fl:['#f2d36b', '#e88aa0', '#c9b6ff', '#ffffff'], fp:.72, pond:['#2f6f8c', '#4a93b0'] },
  { g:['#5b8a37', '#578533'], bl:['#76a344', '#467232'], path:['#9a7f55', '#b29665', '#836a47'], tree:['#244625', '#33612f', '#4a823c'], forest:'#1e321c', fl:['#ffd84a', '#ff9a4a', '#ffffff', '#ff6f8a'], fp:.66, pond:['#2a7690', '#4a9cb8'] },
  { g:['#7d7638', '#787135'], bl:['#a08e45', '#5f582c'], path:['#8f7350', '#a8875e', '#76603f'], tree:['#5a2a1a', '#97401e', '#cf6f2a'], forest:'#2a2218', fl:['#e07a3a', '#c94a3a', '#f2b84b'], fp:.8, pond:['#2d5f72', '#43819a'] },
  { g:['#dfe7ef', '#d8e1ea'], bl:['#ffffff', '#b8c6d4'], path:['#b9b2a8', '#cdc7bd', '#a39b90'], tree:['#22322d', '#2e463c', '#eef4f8'], forest:'#1d272b', fl:[], fp:2, pond:['#9fc4d8', '#c8e2ee'] }
];

/* ================= state ================= */
const VIDS = Object.keys(VILLAGERS);
function zeroMap() { const o = {}; VIDS.forEach(v => o[v] = 0); return o; }
function newState() {
  const plots = [];
  for (let i = 0; i < 56; i++) plots.push({ t:0, c:null, d:0, w:false, ready:false, s:false });
  return { v:2, year:1, season:0, day:1, time:360, coins:150, energy:100, maxEnergy:100, can:20, canMax:20, sel:'mint',
    seeds:{ mint:6, ember:3 }, sprinklers:0, inv:{}, plots, slots:1, brewing:[], reqs:[], steps:zeroMap(), hearts:zeroMap(), gifts:{},
    helped:0, missed:0, rain:false, snow:false, nextRain:false, fr:zeroMap(), talked:{}, gifted:{}, scenes:{}, known:{}, tut:0, up:{}, debt:2000, proj:{}, done:{},
    greenhouse:false, rod:false, lantern:false, almanac:false, bell:false, hives:0, speed:5, over:false, fishCaught:0 };
}
function migrate(s) {
  if (!s || typeof s !== 'object') return null;
  if (s.v === 1) {
    const n = Object.assign(newState(), s);
    n.v = 2; n.year = 1; n.season = 0; n.debt = 2000;
    n.steps = Object.assign(zeroMap(), s.steps || {});
    n.hearts = zeroMap();
    for (const v of VIDS) n.hearts[v] = Math.min(3, (s.steps && s.steps[v]) || 0);
    n.plots = (s.plots || []).map(p => Object.assign({ t:0, c:null, d:0, w:false, ready:false, s:false }, p));
    while (n.plots.length < 56) n.plots.push({ t:0, c:null, d:0, w:false, ready:false, s:false });
    n.maxEnergy = 100; n.gifts = {}; n.proj = {}; n.done = {};
    n.fr = zeroMap(); for (const v of VIDS) n.fr[v] = n.hearts[v] * 100;
    n.pendingGifts = true;
    return n;
  }
  if (s.v === 2) {
    const n = Object.assign(newState(), s);
    n.steps = Object.assign(zeroMap(), s.steps || {}); n.hearts = Object.assign(zeroMap(), s.hearts || {});
    if (!s.fr) { n.fr = zeroMap(); for (const v of VIDS) n.fr[v] = (n.hearts[v] || 0) * 100; for (const v of VIDS) for (const l of [3, 6]) if (n.gifts[v + l]) n.fr[v] = Math.max(n.fr[v], l * 100); }
    else n.fr = Object.assign(zeroMap(), s.fr);
    for (const k of ['talked', 'gifted', 'scenes', 'known']) n[k] = Object.assign({}, s[k] || {});
    if (n.year === 1 && n.season === 0 && n.debt === 2500) n.debt = 2000;
    return n;
  }
  return null;
}
let S = null;
function load() { try { const raw = localStorage.getItem(SAVE_KEY); if (!raw) return null; return migrate(JSON.parse(raw)); } catch (e) { return null; } }
function save() { if (!S) return; try { localStorage.setItem(SAVE_KEY, JSON.stringify(S)); } catch (e) {} }
function clearSave() { try { localStorage.removeItem(SAVE_KEY); } catch (e) {} }

/* ---------- rules helpers ---------- */
const firstSeason = id => Math.min(...CROPS[id].seasons);
const cropKnown = id => S.year > 1 || S.season >= firstSeason(id);
const inSeason = id => CROPS[id].seasons.includes(S.season);
function cropLockedToday(id) { const cr = CROPS[id]; return S.year === 1 && S.season === firstSeason(id) && S.day < cr.unlock; }
function seedForSale(id) {
  if (!cropKnown(id) || cropLockedToday(id)) return false;
  return inSeason(id) || S.greenhouse;
}
const isGH = i => S.greenhouse && plotRow(i) >= GH_ROW;
const potionKnown = id => Object.keys(POTIONS[id].need).every(k => cropKnown(k));
const passOut = () => S.lantern ? 1560 : 1440;
const fmt = n => Math.round(n).toLocaleString();

/* ================= runtime ================= */
let W = 0, H = 0, dpr = 1, T = 40, ox = 0, oy = 0, bg = null, bgSeason = -1;
let witch = { x:1, y:2, dir:1, walk:0, act:0, tool:null }, cat = { x:0.4, y:2.4, trail:[], mv:0, dir:1 };
let queue = [], parts = [], floats = [], drops = [], flies = [];
let mode = 'title', sheetOpen = null, clock = 0, saveTimer = 0;

function resize() {
  W = innerWidth; H = innerHeight; dpr = Math.min(2, window.devicePixelRatio || 1);
  C.width = Math.round(W * dpr); C.height = Math.round(H * dpr);
  const top = $('hud').getBoundingClientRect().height - 6;
  const bot = $('tray').getBoundingClientRect().height;
  const aw = W - 12, ah = H - top - bot - 8;
  T = Math.max(20, Math.floor(Math.min(aw / COLS, ah / ROWS)));
  ox = Math.round((W - T * COLS) / 2); oy = Math.round(top + (ah - T * ROWS) / 2 + 4);
  buildStatic();
  flies = []; for (let i = 0; i < 14; i++) flies.push({ x:Math.random(), y:Math.random(), p:Math.random() * 6 });
  drops = []; for (let i = 0; i < 70; i++) drops.push({ x:Math.random() * W, y:Math.random() * H, v:420 + Math.random() * 260, r:Math.random() });
}

/* ================= drawing ================= */
function R(g, x, y, w, h, col) { g.fillStyle = col; g.fillRect(Math.round(x), Math.round(y), Math.max(1, Math.round(w)), Math.max(1, Math.round(h))); }
function circ(g, x, y, r, col) { g.fillStyle = col; g.beginPath(); g.arc(x, y, Math.max(.5, r), 0, Math.PI * 2); g.fill(); }
function tree(g, x, y, s, seed, pal, season) {
  R(g, x - s * .08, y - s * .35, s * .16, s * .38, '#4a3122');
  const sh = pal.tree;
  if (season === 3) {
    g.fillStyle = sh[0]; g.beginPath(); g.moveTo(x, y - s * 1.12); g.lineTo(x - s * .42, y - s * .28); g.lineTo(x + s * .42, y - s * .28); g.closePath(); g.fill();
    g.fillStyle = sh[1]; g.beginPath(); g.moveTo(x, y - s * 1.12); g.lineTo(x - s * .3, y - s * .6); g.lineTo(x + s * .3, y - s * .6); g.closePath(); g.fill();
    g.fillStyle = sh[2]; g.beginPath(); g.moveTo(x, y - s * 1.12); g.lineTo(x - s * .16, y - s * .84); g.lineTo(x + s * .16, y - s * .84); g.closePath(); g.fill();
    R(g, x - s * .36, y - s * .34, s * .72, s * .05, sh[2]);
    return;
  }
  circ(g, x, y - s * .55, s * .42, sh[0]);
  circ(g, x - s * .18, y - s * .62, s * .3, sh[1]);
  circ(g, x + s * .15, y - s * .7, s * .26, sh[1]);
  circ(g, x - s * .05, y - s * .78, s * .18, sh[2]);
  if (seed > .7 && season < 2) { circ(g, x + s * .12, y - s * .5, s * .04, '#e05a6a'); circ(g, x - s * .2, y - s * .55, s * .04, '#e05a6a'); }
}

function buildStatic() {
  const season = S ? S.season : 0, pal = PAL[season];
  bgSeason = season;
  bg = document.createElement('canvas'); bg.width = C.width; bg.height = C.height;
  const g = bg.getContext('2d'); g.setTransform(dpr, 0, 0, dpr, 0, 0);
  const u = T / 16;
  R(g, 0, 0, W, H, pal.forest);
  for (let i = 0; i < 260; i++) {
    const x = hash(i, 1, 9) * W, y = hash(i, 2, 9) * H;
    if (x > ox - T * .3 && x < ox + COLS * T + T * .3 && y > oy - T * .2 && y < oy + ROWS * T + T * 1.2) continue;
    tree(g, x, y + T, T * (1 + hash(i, 3, 9) * .6), hash(i, 4, 9), pal, season);
  }
  for (let r = 0; r < ROWS; r++) for (let c = 0; c < COLS; c++) {
    const x = ox + c * T, y = oy + r * T, k = tileKind(c, r);
    if (k === 'path') {
      R(g, x, y, T, T, pal.path[0]);
      for (let i = 0; i < 5; i++) { const a = hash(c, r, i), b = hash(c, r, i + 9); R(g, x + a * (T - 2 * u), y + b * (T - 2 * u), 2 * u, 1.4 * u, i % 2 ? pal.path[1] : pal.path[2]); }
    } else {
      R(g, x, y, T, T, pal.g[(c + r) % 2]);
      for (let i = 0; i < 6; i++) { const a = hash(c, r, i), b = hash(c, r, i + 20); R(g, x + a * (T - u), y + b * (T - 2 * u), u, 2 * u, i % 3 ? pal.bl[0] : pal.bl[1]); }
      if (k === 'grass' && !buildingAt(c, r) && hash(c, r, 99) > pal.fp && pal.fl.length) {
        const fc = pal.fl[(hash(c, r, 98) * pal.fl.length) | 0];
        for (let i = 0; i < 3; i++) circ(g, x + (.2 + hash(c, r, 50 + i) * .6) * T, y + (.2 + hash(c, r, 60 + i) * .6) * T, u * 1.1, fc);
      }
    }
  }
  const px = ox + T, py = oy + 12 * T;
  g.fillStyle = pal.pond[0]; g.beginPath(); g.ellipse(px + T, py + T * .52, T * .95, T * .42, 0, 0, Math.PI * 2); g.fill();
  g.fillStyle = pal.pond[1]; g.beginPath(); g.ellipse(px + T * .85, py + T * .44, T * .6, T * .2, 0, 0, Math.PI * 2); g.fill();
  if (season !== 3) { circ(g, px + T * 1.45, py + T * .6, u * 2.2, '#5d9a48'); circ(g, px + T * .55, py + T * .62, u * 1.6, '#5d9a48'); if (season < 2) circ(g, px + T * 1.42, py + T * .52, u * .9, '#f2a3c0'); }
  else { g.strokeStyle = 'rgba(255,255,255,.6)'; g.lineWidth = u * .6; g.beginPath(); g.moveTo(px + T * .5, py + T * .4); g.lineTo(px + T * .9, py + T * .6); g.moveTo(px + T * 1.2, py + T * .35); g.lineTo(px + T * 1.5, py + T * .55); g.stroke(); }
  const fx0 = ox + FIELD.c0 * T, fy0 = oy + FIELD.r0 * T, fx1 = ox + (FIELD.c1 + 1) * T, fy1 = oy + (FIELD.r1 + 1) * T;
  const gateL = ox + 4 * T, gateR = ox + 5 * T, rail = '#b08c5c', post = '#d9b886';
  const railH = (x0, x1, y) => { if (x1 > x0) { R(g, x0, y - u * 2.5, x1 - x0, u, rail); R(g, x0, y - u * .5, x1 - x0, u, rail); } };
  railH(fx0 - u, gateL, fy0); railH(gateR, fx1 + u, fy0); railH(fx0 - u, fx1 + u, fy1);
  R(g, fx0 - u, fy0, u, fy1 - fy0, rail); R(g, fx1, fy0, u, fy1 - fy0, rail);
  for (let c = FIELD.c0; c <= FIELD.c1 + 1; c++) { const x = ox + c * T; R(g, x - u, fy0 - 4 * u, 2 * u, 5 * u, post); R(g, x - u, fy1 - 4 * u, 2 * u, 5 * u, post); }
  for (let r = FIELD.r0; r <= FIELD.r1 + 1; r++) { const y = oy + r * T; R(g, fx0 - 1.5 * u, y - 3 * u, 2 * u, 4 * u, post); R(g, fx1 - .5 * u, y - 3 * u, 2 * u, 4 * u, post); }
  for (const [c, r] of [[3, 0], [7, 0], [0, 12], [4, 12], [6, 12], [8, 12], [0, 4], [0, 8]]) tree(g, ox + (c + .5) * T, oy + (r + 1) * T, T * 1.05, hash(c, r, 3), pal, season);
  drawCottage(g, season); drawCauldronBase(g); drawBoardBase(g, season); drawWell(g, season); drawStall(g, season);
}
function drawCottage(g, season) {
  const b = BUILD.cottage, x = ox + b.c * T, y = oy + b.r * T, w = b.w * T, h = b.h * T, u = T / 16;
  g.fillStyle = 'rgba(0,0,0,.25)'; g.beginPath(); g.ellipse(x + w / 2, y + h - u, w * .48, u * 3, 0, 0, 7); g.fill();
  R(g, x + 2 * u, y + h * .48, w - 4 * u, h * .52 - u, '#8b8273');
  for (let i = 0; i < 26; i++) R(g, x + 3 * u + hash(i, 7, 1) * (w - 9 * u), y + h * .5 + hash(i, 7, 2) * (h * .45 - 3 * u), 4 * u, 2 * u, i % 2 ? '#9d9584' : '#776e60');
  R(g, x + w - 9 * u, y + h * .05, 4 * u, h * .3, '#6b5a4d');
  g.fillStyle = '#5a3a6c'; g.beginPath(); g.moveTo(x - u, y + h * .55); g.lineTo(x + w * .18, y + h * .08); g.lineTo(x + w * .82, y + h * .08); g.lineTo(x + w + u, y + h * .55); g.closePath(); g.fill();
  g.strokeStyle = '#47295a'; g.lineWidth = u * .9;
  for (let i = 1; i < 6; i++) { const yy = y + h * .08 + i * (h * .47 / 6); g.beginPath(); g.moveTo(x + w * .18 - (yy - y - h * .08) * .4, yy); g.lineTo(x + w * .82 + (yy - y - h * .08) * .4, yy); g.stroke(); }
  if (season === 3) { g.fillStyle = '#f4f8fb'; g.beginPath(); g.moveTo(x + w * .16, y + h * .1); g.lineTo(x + w * .84, y + h * .1); g.lineTo(x + w * .9, y + h * .2); g.lineTo(x + w * .1, y + h * .2); g.closePath(); g.fill(); R(g, x + w - 9 * u, y + h * .04, 4 * u, 1.5 * u, '#f4f8fb'); }
  if (season === 2) { for (let i = 0; i < 7; i++) circ(g, x + w * (.1 + i * .13), y + h * .55, u * 1.3, ['#e07a3a', '#c94a3a', '#f2b84b'][i % 3]); }
  R(g, x + w * .45, y + h * .62, w * .13, h * .38 - u, '#5a3a24'); circ(g, x + w * .55, y + h * .82, u * .7, '#f2b84b');
  R(g, x + w * .12, y + h * .64, w * .2, h * .2, '#3a2a1c');
  R(g, x + w * .7, y + h * .64, w * .2, h * .2, '#3a2a1c');
}
function drawCauldronBase(g) {
  const b = BUILD.cauldron, cx = ox + (b.c + .5) * T, cy = oy + (b.r + .62) * T, u = T / 16;
  R(g, cx - 5 * u, cy + 3 * u, 2 * u, 4 * u, '#2a2230'); R(g, cx + 3 * u, cy + 3 * u, 2 * u, 4 * u, '#2a2230');
  g.fillStyle = '#e8813a'; g.beginPath(); g.ellipse(cx, cy + 6.5 * u, 4 * u, 1.5 * u, 0, 0, 7); g.fill();
  g.fillStyle = '#231d29'; g.beginPath(); g.ellipse(cx, cy + u, 6.5 * u, 5.5 * u, 0, 0, 7); g.fill();
  g.fillStyle = '#3a3142'; g.beginPath(); g.ellipse(cx, cy - 3 * u, 6.5 * u, 1.8 * u, 0, 0, 7); g.fill();
}
function drawBoardBase(g, season) {
  const b = BUILD.board, x = ox + b.c * T, y = oy + b.r * T, u = T / 16;
  R(g, x + 3 * u, y + 4 * u, 2 * u, 12 * u, '#5a3d26'); R(g, x + 11 * u, y + 4 * u, 2 * u, 12 * u, '#5a3d26');
  R(g, x + 1 * u, y + 3 * u, 14 * u, 9 * u, '#8a6440'); R(g, x + 2 * u, y + 4 * u, 12 * u, 7 * u, '#a57a4f');
  R(g, x, y + 1.5 * u, 16 * u, 2 * u, season === 3 ? '#f4f8fb' : '#5a3a6c');
